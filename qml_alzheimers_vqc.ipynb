    "# Choose backend execution mode: 'statevector' or 'aer_simulator'\n",
    "sampler = StatevectorSampler()\n",
    "from qiskit_machine_learning.optimizers import COBYLA\n",
    "\n",
    "# Tracking callback\n",
    "loss_history = []\n",
    "\n",
    "def callback_vqc(weights, loss_value):\n",
    "    loss_history.append(loss_value)\n",
    "    if len(loss_history) % 5 == 0 or len(loss_history) == 1:\n",
    "        print(f\"Iteration {len(loss_history):02d} | Loss: {loss_value:.5f}\")\n",
    "\n",
    "# Build VQC Model\n",
    "max_iterations = 60\n",
    "vqc_model = VQC(\n",
    "    feature_map=feature_map,\n",
    "    ansatz=ansatz,\n",
    "    optimizer=COBYLA(maxiter=max_iterations),\n",
    "    loss=\"cross_entropy\",\n",
    "    sampler=sampler,\n",
    "    callback=callback_vqc\n",
    ")\n",
    "\n",
    "print(f\"Beginning VQC training with COBYLA (maxiter={max_iterations})...\")\n",
    "start_vqc = time.time()\n",
